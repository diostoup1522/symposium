<div id="<%= dom_id discussion %>" class="w-full my-5 space-y-5">
  <div>
    <p class="block font-light mb-1 text-sm"><%= link_to discussion.creator.username, discussion.creator %></p>
    <div class="block font-normal mb-1 text-xl">
      <strong>"<%= discussion.book %>"</strong> by: <strong><%= discussion.author %></strong>
    </div>
    <div class="break-words">
      <strong class="block font-medium mb-1">Description:</strong>
      <%= discussion.description %>
    </div>
  </div>
</div>
