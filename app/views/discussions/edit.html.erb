<% content_for :title, "Editing discussion" %>

<div class="flex justify-center text-lg bg-white p-5 rounded-xl z-10">
  <span class="text-left">
    <h1 class="font-bold text-4xl text-center">Editing discussion</h1>

    <%= render "form", discussion: @discussion %>

    <div class="flex flex-col gap-4">
      <%= link_to "Show this discussion", @discussion, class: "w-full text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium mx-auto" %>
      <%= link_to "Back to discussions", discussions_path, class: "w-full text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 font-medium mx-auto" %>
    </div>
  </span>
</div>
