<%= form_with model: discussion, class: "block", data: { controller: "resizable-form" } do |form| %>
  <div class="w-full">
    <%= form.label :book, class: "text-xl font-medium pl-2" %><br>
    <%= form.text_field :book, required: true, maxlength: 30, data: { resizable_form_target: "input" }, class: "mx-auto block text-center sm:text-left text-xl font-medium pl-2 pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %>
  </div>

  <div class="w-full">
    <%= form.label :author, class: "text-xl font-medium pl-2" %><br>
    <%= form.text_field :author, required: true, maxlength: 30, data: { resizable_form_target: "input" }, class: "mx-auto block text-xl font-medium pl-2 pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %>
  </div>

  <div class="w-full">
    <%= form.label :description, class: "text-xl font-medium pl-2" %><br>
    <%= form.text_area :description, required: true, maxlength: 300, rows: 5, cols: 30, data: { resizable_form_target: "area" }, class: "mx-auto block text-xl font-medium pl-2 pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %>
  </div>

  <div class="text-center mb-4">
    <%= form.submit class: "cursor-pointer" %>
  </div>
<% end %>
