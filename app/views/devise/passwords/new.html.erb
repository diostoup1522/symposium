<div class="mx-auto text-center">
  <h2 class="text-xl font-bold">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <div class="field">
      <p><%= f.label :email %></p>
      <p><%= f.email_field :email, required: true, autofocus: true, autocomplete: "username", size: 30, class: "mx-auto block text-xl font-medium pl-2 pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %></p>
    </div>

    <div class="actions">
      <%= f.submit "Send me password reset instructions", class: "block cursor-pointer rounded-full actions text-center px-4 py-1 border-[2px] bg-black hover:bg-gray-900 active:bg-gray-800 font-medium text-white mx-auto" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
