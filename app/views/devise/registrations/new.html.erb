
<div class="flex justify-center text-lg bg-white p-5 rounded-xl z-10">
  <span class="text-left">
    <h2 class="text-center text-3xl">Sign up</h2>
    <p class="text-base text-center mb-0.5"><%= link_to "Already have an account? Log in", new_session_path(resource_name), class: "text-cyan-500 hover:text-cyan-700" %></p>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <div class="field">
        <p><%= f.label :username, class: "text-xl font-medium pl-2" %></p>
        <p><%= f.text_field :username, required: true, minlength: 3, maxlength: 15, size: "35", pattern: "[a-zA-Z0-9]+([a-zA-Z0-9](_|-)[a-zA-Z0-9])*[a-zA-Z0-9]+", class: "pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %></p>
        <ul class="text-sm list-disc ml-[1rem] list-inside">
          <li>Username must be 3 to 15 chraracters,</li>
          <li>special characters not allowed,</li>
          <li>no consecutive hyphens/underscores.</li>
        </ul>
      </div>

      <div class="field">
        <p><%= f.label :displayname, class: "text-xl font-medium pl-2" %></p>
        <p><%= f.text_field :displayname, required: true, minlength: 3, maxlength: 25, size: "35", pattern: "[A-Za-z]+(?: [A-Za-z]+)*", class: "pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %></p>
        <ul class="text-sm list-disc ml-[1rem] list-inside">
          <li>Displayname must be 3 to 25 characters,</li>
          <li>only letters and spaces allowed.</li>
        </ul>
      </div>

      <div class="field">
        <p><%= f.label :email, class: "text-xl font-medium pl-2" %></p>
        <p><%= f.email_field :email, required: true, autofocus: true, autocomplete: "username", size: "35", class: "pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password, class: "text-xl font-medium pl-2" %></p>
        <% if @minimum_password_length %>
          <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
        <% end %>
        <p><%= f.password_field :password, required: true, minlength: 6, maxlength: 128, size: "35", autocomplete: "new-password", class: "pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %></p>
      </div>

      <div class="field">
        <p><%= f.label :password_confirmation, class: "text-xl font-medium pl-2" %></p>
        <p><%= f.password_field :password_confirmation, required: true, minlength: 6, maxlength: 128, size: "35", autocomplete: "new-password", class: "pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px]" %></p>
      </div>

      <div class="actions">
        <%= f.submit "Sign up", class: "block cursor-pointer rounded-full actions text-center px-20 py-1 border-[2px] bg-black hover:bg-gray-900 active:bg-gray-800 font-medium text-white mx-auto" %>
      </div>
      
    <% end %>
    <%- if devise_mapping.omniauthable? %>
      <%- resource_class.omniauth_providers.each do |provider| %>
        <span class="flex justify-center"><%= button_to(image_tag("#{"#{provider}".split('_', -1)[0]}.png").html_safe, omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "cursor-pointer") %></span>
      <% end %>
    <% end %>
    <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
      <p class="text-sm text-center"><%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name), class: "text-cyan-500 hover:text-cyan-700" %></p>
    <% end %>

    <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
      <p class="text-sm text-center"><%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name), class: "text-cyan-500 hover:text-cyan-700" %></p>
    <% end %> 
  </span>
</div>
