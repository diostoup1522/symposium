<%= form_with model: [@discussion, @message], id: @form_id, class: "w-full flex mb-2", local: false do |f| %>
  <%= f.text_area :body, required: true, maxlength: 150, rows: 2, class: "flex-1 font-medium pl-2 pl-[0.5rem] pr-[0.5rem] text-base bg-indigo-50 rounded-md outline-none border-[1px] resize-none" %>
  <%= f.submit "Send", class: "cursor-pointer mx-2" %>
<% end %>
